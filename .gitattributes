* text=auto eol=lf

# Ansible
*.yml           text eol=lf
*.yaml          text eol=lf
*.j2            text eol=lf

# Configuration & data
*.cfg           text eol=lf
*.ini           text eol=lf
*.json          text eol=lf diff=json
*.toml          text eol=lf

# Documentation & scripts
*.md            text eol=lf diff=markdown
*.sh            text eol=lf

# Binary assets
*.gif           binary
*.gz            binary
*.ico           binary
*.jpg           binary
*.jpeg          binary
*.png           binary
*.webp          binary
*.woff          binary
*.woff2         binary
*.zip           binary

# Export rules
/.ai            export-ignore
/.agents        export-ignore
/.claude        export-ignore
/.codex         export-ignore
/.github        export-ignore
/.vscode        export-ignore
/molecule       export-ignore
/tests          export-ignore
.ansible-lint   export-ignore
.editorconfig   export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
AGENTS.md       export-ignore
CLAUDE.md       export-ignore
